{
  "type": "object",
  "required": ["id", "title", "publishedYear", "category"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^book_[a-z0-9]+$",
      "description": "ID định danh sách (có prefix book_)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Tiêu đề sách"
    },
    "publishedYear": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 2026,
      "description": "Năm xuất bản"
    },
    "genre": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string", "description": "Tên thể loại" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Mã slug chuẩn hóa" }
      },
      "description": "Thể loại thuộc về"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fullName"],
        "properties": {
          "id": { "type": "string" },
          "fullName": { "type": "string" },
          "role": { "enum": ["lead", "co", "translator"], "default": "co" }
        }
      },
      "description": "Danh sách tác giả viết sách"
    }
  }
}