{
    "type": "object",
    "required": ["id", "title", "price"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^book_[a-z0-9]+$"
    },
      "title": {
        "type": "string",
        "minLength": 1
    },
      "isbn": {
        "type": "string",
        "pattern": "^\\d{13}$"
    },
      "price": {
        "type": "object",
        "properties": {
          "amount": {"type": "integer", "minimum": 0},
          "currency": {"enum": ["VND", "USD", "EUR"]}
        }
      },
      "authors": {
        "type": "array", "minItems": 1,
        "items": {"$ref": "#/$defs/author"}
      }
    },
    "$defs": {
      "author": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"}, "name": {"type": "string"},
          "role": {"enum": ["lead", "co", "ed"]}
        }
      }
    }
}
